# API URL selection is automatic:
# - Running in the browser on localhost/127.0.0.1 uses the local backend.
# - Running on a deployed domain uses the production backend.
# - npm run dev proxies /api to the selected backend.
#
# Optional: set this only when your backend is not on http://localhost:8080.
# Example: VITE_API_ORIGIN="http://localhost:9090"
VITE_API_ORIGIN=""
#
# Optional escape hatch. Use only when you explicitly want to force a target.
# Allowed values: local, prod
VITE_API_TARGET=""

# Optional Gemini key used by Vite config.
GEMINI_API_KEY=""
